.venv/
.env
.env.local
__pycache__/
*.pyc
*.egg-info/
.ruff_cache/

# Real/ad-hoc run outputs (transcripts, metrics, reports) can contain
# private meeting content and can be hundreds of MB per run.
runs/*

# Synthetic benchmark outputs are safe fixtures and should be versioned.
!runs/synthetic*/
!runs/synthetic*/**

# Any audio the user drops here for ad-hoc testing.
audio/
*.caf
*.wav
*.mp3
*.m4a

.DS_Store

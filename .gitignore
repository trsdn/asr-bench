.venv/
.venv-*/
.env
.env.local
__pycache__/
*.pyc
*.egg-info/
.ruff_cache/

# Run outputs (transcripts, metrics, reports) — don't commit to the repo,
# they can be hundreds of MB per run.
runs/

# Generated sessions (synthetic audio + references) and the TTS render
# cache. Both are reproducible from conversations/*.yaml, so they stay
# out of git — the scripts are the source of truth, not the waveforms.
sessions/
.tts-cache/
# Piper voice models, downloaded on first use.
.piper-voices/

# Any audio the user drops here for ad-hoc testing.
audio/
*.caf
*.wav
*.mp3
*.m4a

.DS_Store
